      <aliases enabled='yes' />
      <column caption='Cogs' datatype='real' name='[COGS]' role='measure' type='quantitative' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0808269060542464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN SUM([Profit]) / SUM([Sales]) END' />
      </column>
      <column caption='Total Discounts' datatype='real' name='[Calculation_0808269060653057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Discounts])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0808269060771842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Sales])' />
      </column>
      <column caption='COGS to Sale Ratio' datatype='real' name='[Calculation_0808269060915203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN SUM([COGS]) / SUM([Sales]) END' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_0808269061197828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Sales]) - SUM([Discounts])' />
      </column>
      <column caption='Discount Impact' datatype='real' name='[Calculation_0808269061324805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Gross Sales]) != 0 THEN SUM([Discounts]) / SUM([Gross Sales]) END' />
      </column>
      <column caption='Year-over-Year Growth' datatype='real' name='[Calculation_0808269061435398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1)) / ABS(LOOKUP(SUM([Sales]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='COGS percentage' datatype='real' name='[Calculation_0808269061603335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Gross Sales]) != 0 THEN SUM([COGS]) / SUM([Gross Sales]) END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
